# RSK RPC URL for logs scanning which is not supported by the public RPCs
VITE_RSK_LOG_SCAN_ENDPOINT=

# WalletConnect project id
# WalletConnect option will not be visible if not set
VITE_WALLETCONNECT_PROJECT_ID=

# Token for the Chatwoot website inbox
# The chat widget will not be loaded if not set
VITE_CHATWOOT_TOKEN=

# Secret used to sign API requests to a specific backend. Only used for
# backends whose config record sets "authSecretEnv" to this variable's name;
# must match that backend's own authSecret in boltz.conf. Each backend that
# requires authentication needs its own env var and its own entry in the
# backend's config record.
#
# Despite the VITE_ prefix, this is NOT read by the Vite/app build - it's
# baked into wasm/api-auth's compiled .wasm by "npm run build:wasm-auth"
# (run that after setting this, before "npm run build")
VITE_API_AUTH_SECRET=
